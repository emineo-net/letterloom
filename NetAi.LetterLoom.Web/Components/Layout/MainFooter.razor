<footer class="web-footer">
    <div class="web-container">
        <div class="web-footer-grid">

            <div class="web-footer-brand">
                <a href="" class="web-brand">
                    <i class="bi bi-stars"></i>
                    <span>LetterLoom</span>
                </a>
                <p>@Loc["Cover letters that convince. One-time EUR 39, no subscription trap."]</p>
            </div>

            <div class="web-footer-col">
                <h4>@Loc["Product"]</h4>
                <ul>
                    <li>
                        <a href="">@Loc["Home"]</a>
                    </li>
                    <li>
                        <a href="pricing">@Loc["Pricing"]</a>
                    </li>
                    <li>
                        <a href="about">@Loc["About LetterLoom"]</a>
                    </li>
                    <li>
                        <a href="activate">@Loc["Activate license"]</a>
                    </li>
                </ul>
            </div>

            <div class="web-footer-col">
                <h4>@Loc["Legal"]</h4>
                <ul>
                    <li>
                        <a href="legal/imprint">@Loc["Imprint"]</a>
                    </li>
                    <li>
                        <a href="legal/privacy">@Loc["Privacy"]</a>
                    </li>
                    <li>
                        <a href="legal/terms">@Loc["Terms and Conditions"]</a>
                    </li>
                    <li>
                        <a href="legal/withdrawal">@Loc["Right of withdrawal"]</a>
                    </li>
                </ul>
            </div>

            <div class="web-footer-col">
                <h4>@Loc["Contact"]</h4>
                <ul>
                    <li>
                        <a href="/contact">@Loc["Contact form"]</a>
                    </li>
                    <li>
                        <a href="/activate">@Loc["License help"]</a>
                    </li>
                </ul>
            </div>

        </div>

        <div class="web-footer-bottom">
            <span>© @DateTime.UtcNow.Year NetAi - LetterLoom</span>
            <span>-</span>
            <span>Made with .NET 10 &amp; Blazor WASM</span>
        </div>
    </div>
</footer>