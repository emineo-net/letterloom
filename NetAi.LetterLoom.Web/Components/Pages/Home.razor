<section class="web-section">
    <div class="web-container">
        <div class="web-cta">
            <h2>@Loc["Ready to try it out?"]</h2>
            <p>@Loc["Download LetterLoom and create your first 5 cover letters for free."]</p>

            <a href="@SetupUrl"
               class="btn btn-primary btn-lg btn-icon @(IsReady ? "" : "disabled")"
               aria-disabled="@(IsReady ? null : "true")"
               tabindex="@(IsReady ? 0 : -1)">
                <i class="bi bi-download"></i>
                <span>@Loc["Download for free"]</span>
            </a>

            <!-- Portable-Download -->
            <div style="margin-top: 1rem;">
                <a href="@PortableUrl"
                   class="text-decoration-none small @(IsPortableReady ? "" : "disabled")"
                   aria-disabled="@(IsPortableReady ? null : "true")"
                   tabindex="@(IsPortableReady ? 0 : -1)">
                    <i class="bi bi-box-seam"></i>
                    @Loc["Or download the portable version (no installation required)"]
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private DownloadManifest? manifest;

    private bool IsReady => !string.IsNullOrEmpty(manifest?.Setup);
    private string SetupUrl => IsReady ? $"/downloads/{manifest!.Setup}" : "#";

    private bool IsPortableReady => !string.IsNullOrEmpty(manifest?.Portable);
    private string PortableUrl => IsPortableReady ? $"/downloads/{manifest!.Portable}" : "#";

    protected override async Task OnInitializedAsync()
    {
        manifest = await Downloads.GetManifestAsync();
    }

}