<!-- FAQ                                                            -->
<!-- ============================================================ -->
<section id="faq" class="web-section">
    <div class="web-container web-narrow">
        <div class="web-section-head">
            <h2>@Loc["Frequently asked questions"]</h2>
            <p>@Loc["Everything you want to know before buying."]</p>
        </div>

        <div class="web-faq">
            <details class="web-faq-item">
                <summary>
                    <span>@Loc["Is LetterLoom really free to try?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["Yes. You can download LetterLoom and create the first"]
                    <strong>@Loc["5 cover letters for free"] @Loc["completely and without restrictions"]</strong>@Loc[". From the 6th cover letter onwards, the result is displayed as a shortened preview image with watermark - but the app remains fully usable. This way you can calmly check whether LetterLoom is right for you."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["Do I need a strong graphics card?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["No. The local models run smoothly with"]
                    <strong>8 GB VRAM and 16 GB RAM</strong>@Loc[". It also works entirely without a dedicated GPU - then a cover letter takes a bit longer. If you want maximum speed, you can connect your own API (OpenAI, OpenRouter, Ollama ...) instead and don't need any local computing power at all."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["Where does my data go (CV, job ad, cover letter)?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["With local use, your data"]
                    <strong>@Loc["never leaves your PC"]</strong>@Loc[". CV, job ads, and cover letters are stored in a local SQLite database on your hard drive. There is no cloud connection, no registration, and no telemetry. Only if you voluntarily connect an API are the contents sent to the endpoint of your choice."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["What is the difference from ChatGPT?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["LetterLoom is"]
                    <strong>@Loc["built specifically for applications"]</strong>@Loc[": It automatically compares your CV with the job ad, identifies missing qualifications, filters out redundant skills, and formulates the cover letter according to fixed anti-cliche rules. With ChatGPT, you have to orchestrate these steps yourself each time and write the prompt yourself. LetterLoom does this in one workflow - and optionally locally, without data transfer. A direct comparison can be found in the section above."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["In which languages does LetterLoom work?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["The user interface is available in"]
                    <strong>@Loc["German, English, Italian, and Russian"]</strong>@Loc[". The generated cover letter automatically uses the language of the job ad - regardless of which UI language is set."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["Can I use the license on multiple PCs?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["A license is valid for"]
                    <strong>@Loc["one computer"]</strong>@Loc[". If you want to install LetterLoom on a new PC, write to us via"]
                    <a href="/contact">@Loc["Contact form"]</a>
                    @Loc["- we'll help with the transfer."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["Is there a refund?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["The purchase is processed via Paddle (Merchant of Record). Statutory withdrawal rules apply - details can be found in our"]
                    <a href="legal/withdrawal">@Loc["withdrawal policy"]</a>@Loc[". For consumers, the 14-day right of withdrawal applies. Since you can test LetterLoom with 5 cover letters for free beforehand, we recommend using the trial before purchasing."]
                </div>
            </details>

            <details class="web-faq-item">
                <summary>
                    <span>@Loc["Do I get updates for free?"]</span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="web-faq-body">
                    @Loc["Yes. Updates within the current major version (1.x) are"]
                    <strong>@Loc["Free"]</strong>@Loc[". Should a new major version ever appear, we will inform you in advance by email."]
                </div>
            </details>
        </div>

        <p class="web-faq-footer">
            @Loc["Your question isn't listed?"]
            <a href="/contact">@Loc["Contact form"]</a>
            @Loc["- we usually respond within 1-2 business days."]
        </p>
    </div>
</section>


